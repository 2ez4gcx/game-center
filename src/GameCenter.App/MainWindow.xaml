<Window x:Class="GameCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Center" Height="860" Width="1320" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontSize="20">
    <Grid>
        <!-- Lưới mờ trang trí phía sau -->
        <Rectangle Opacity="0.06" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 L48,0 M0,0 L0,48">
                            <GeometryDrawing.Pen><Pen Brush="#00E5FF" Thickness="1"/></GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-380,-260,0" IsHitTestVisible="False" Opacity="0.35">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#6600E5FF" Offset="0"/>
                    <GradientStop Color="#0000E5FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,-360" IsHitTestVisible="False" Opacity="0.3">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#66FF3D9A" Offset="0"/>
                    <GradientStop Color="#00FF3D9A" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="18,22,18,18">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
                        <TextBlock Text="GAME CENTER" FontFamily="{StaticResource TechFont}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource Brand}" Effect="{StaticResource SoftGlow}"/>
                        <TextBlock Text="RETRO  ·  ARCADE  ·  CONSOLE" FontFamily="{StaticResource TechFont}" FontSize="12"
                                   Foreground="{StaticResource FgDim}" Margin="2,2,0,0"/>
                    </StackPanel>

                    <!-- Cách điều khiển -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="CÁCH ĐIỀU KHIỂN" FontFamily="{StaticResource TechFont}" FontSize="14" Foreground="{StaticResource FgDim}" Margin="6,0,0,8"/>
                        <Border CornerRadius="13" Background="#80101A30" BorderBrush="{StaticResource Line}" BorderThickness="1.5">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="ModeGamepad" Style="{StaticResource SegmentButton}" GroupName="mode" Checked="Mode_Checked" Tag="gamepad">
                                    <StackPanel>
                                        <TextBlock Text="🎮" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        <TextBlock Text="Tay cầm" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeKeyboard" Style="{StaticResource SegmentButton}" GroupName="mode" Checked="Mode_Checked" Tag="keyboard">
                                    <StackPanel>
                                        <TextBlock Text="⌨" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        <TextBlock Text="Bàn phím" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="8,10,0,0">
                            <Ellipse x:Name="PadDot" Width="10" Height="10" Fill="#607D8B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PadStatus" Text="Chưa thấy tay cầm" FontSize="15" Foreground="{StaticResource FgDim}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="ControlSetupButton" Content="⚙  Thiết lập nút" Style="{StaticResource BigButton}" Margin="0,10,0,0"
                                HorizontalAlignment="Stretch" Click="ControlSetup_Click"/>
                        <!-- Thông tin tác giả -->
                        <TextBlock x:Name="AuthorText" FontFamily="{StaticResource TechFont}" FontSize="12" Opacity="0.55"
                                   Foreground="{StaticResource FgDim}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Điều hướng: LB/RB trên tay cầm -->
                    <TextBlock DockPanel.Dock="Top" Text="THƯ VIỆN" FontFamily="{StaticResource TechFont}" FontSize="14" Foreground="{StaticResource FgDim}" Margin="6,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,0,16">
                        <StackPanel x:Name="TabsPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ NỘI DUNG ============ -->
            <Grid Grid.Column="1" Margin="28,22,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thanh trên: tìm kiếm + nút -->
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="⟳  Quét" Style="{StaticResource BigButton}" Click="Scan_Click" ToolTip="Quét game mới"/>
                        <Button Content="📂  Thư mục game" Style="{StaticResource BigButton}" Click="OpenGamesFolder_Click"/>
                        <Button Content="⚙" Style="{StaticResource BigButton}" FontSize="24" Padding="10,4" Click="Settings_Click" ToolTip="Cài đặt"/>
                        <Button Content="?" Style="{StaticResource BigButton}" FontSize="24" Padding="10,4" Click="Help_Click" ToolTip="Trợ giúp"/>
                    </StackPanel>
                    <Grid Margin="0,6,12,6">
                        <TextBox x:Name="SearchBox" Padding="40,0,0,0" TextChanged="SearchBox_TextChanged" ToolTip="Gõ tên game để tìm"/>
                        <TextBlock Text="⌕" FontSize="26" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="18,0,0,4" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Tìm game…" FontSize="20" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="50,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>

                <!-- Tiêu đề mục -->
                <DockPanel Grid.Row="1" Margin="4,18,4,10">
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Bottom" FontFamily="{StaticResource TechFont}" FontSize="17" Foreground="{StaticResource FgDim}"/>
                    <TextBlock x:Name="SectionTitle" Text="Tất cả" FontFamily="{StaticResource TechFont}" FontSize="34" FontWeight="SemiBold"/>
                </DockPanel>

                <!-- Danh sách game -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             MouseDoubleClick="GameList_MouseDoubleClick" KeyDown="GameList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,5,8,5"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="16" Padding="12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="b" Property="BorderThickness" Value="2.5"/>
                                                    <Setter TargetName="b" Property="Effect" Value="{StaticResource Glow}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Ảnh bìa hoặc ô màu theo hệ máy -->
                                    <Border Width="88" Height="88" CornerRadius="12" HorizontalAlignment="Left" ClipToBounds="True"
                                            BorderBrush="{Binding PlatformBrush}" BorderThickness="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{Binding PlatformColor}" Offset="0"/>
                                                <GradientStop Color="#0B1328" Offset="1.1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <TextBlock Text="{Binding PlatformShort}" FontFamily="{StaticResource TechFont}" FontSize="22" FontWeight="Bold" Foreground="#F2F7FF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border CornerRadius="8" Padding="10,2" BorderThickness="1.2" BorderBrush="{Binding PlatformBrush}" Background="{Binding PlatformBrushFaint}">
                                                <TextBlock Text="{Binding PlatformName}" FontFamily="{StaticResource TechFont}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding PlatformBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Meta}" FontSize="17" Foreground="{StaticResource FgDim}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Warning}" FontSize="17" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding WarningVisibility}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding FavoriteIcon}" Foreground="{Binding FavoriteBrush}" Style="{StaticResource BigButton}" FontSize="24" Padding="12,4"
                                                ToolTip="Yêu thích" Click="Favorite_Click" Focusable="False"/>
                                        <Button Content="⋯" Style="{StaticResource BigButton}" FontSize="24" Padding="12,4"
                                                ToolTip="Thêm" Click="More_Click" Focusable="False"/>
                                        <Button Content="{Binding PlayLabel}" Style="{StaticResource PlayButton}" Click="Play_Click" Focusable="False"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Khi chưa có game -->
                    <Border x:Name="EmptyPanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1.5" CornerRadius="18" Padding="40"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Effect="{StaticResource SoftGlow}">
                        <StackPanel MaxWidth="760">
                            <TextBlock x:Name="EmptyTitle" Text="Chưa có game nào" FontFamily="{StaticResource TechFont}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="EmptyText" FontSize="22" TextWrapping="Wrap" LineHeight="32"/>
                            <WrapPanel Margin="0,20,0,0">
                                <Button Content="📂  Mở thư mục game" Style="{StaticResource BigButton}" Click="OpenGamesFolder_Click"/>
                                <Button Content="⟳  Quét game mới" Style="{StaticResource PlayButton}" Click="Scan_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Luôn hiển thị cách thoát game (đổi theo cách điều khiển) -->
                <Border Grid.Row="3" CornerRadius="14" Padding="18,12" Margin="0,14,0,0" BorderThickness="1.5" BorderBrush="{StaticResource Accent2}" Background="#33FF3D9A">
                    <DockPanel>
                        <TextBlock x:Name="ControlHint" DockPanel.Dock="Right" FontSize="17" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBlock FontSize="22" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run Text="⏏  THOÁT GAME:" Foreground="{StaticResource Accent2}"/>
                            <Run x:Name="ExitHint" Text=" giữ START + SELECT"/>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
