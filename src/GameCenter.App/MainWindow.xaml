<Window x:Class="GameCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Center" Height="820" Width="1200" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontSize="20">
    <Grid Margin="20,14,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề + tìm kiếm -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="GAME CENTER" FontSize="36" FontWeight="Black" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="26" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="340" TextChanged="SearchBox_TextChanged"
                         ToolTip="Gõ tên game để tìm"/>
            </StackPanel>
        </DockPanel>

        <!-- Bộ lọc: LB/RB trên tay cầm để đổi -->
        <WrapPanel x:Name="TabsPanel" Grid.Row="1" Margin="0,0,0,8"/>

        <!-- Danh sách game -->
        <Grid Grid.Row="2">
            <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="GameList_MouseDoubleClick" KeyDown="GameList_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="Transparent" BorderThickness="4" CornerRadius="10" Padding="10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Ảnh bìa hoặc nhãn hệ máy -->
                            <Border Width="84" Height="84" CornerRadius="8" Background="#34495E" HorizontalAlignment="Left">
                                <Grid>
                                    <TextBlock Text="{Binding PlatformShort}" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="18" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Warning}" FontSize="18" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                           Visibility="{Binding WarningVisibility}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding FavoriteIcon}" Style="{StaticResource BigButton}" MinWidth="60" FontSize="26"
                                        ToolTip="Yêu thích (nút Y)" Click="Favorite_Click" Focusable="False"/>
                                <Button Content="⋯" Style="{StaticResource BigButton}" MinWidth="60" FontSize="26"
                                        ToolTip="Thêm (nút X)" Click="More_Click" Focusable="False"/>
                                <Button Content="{Binding PlayLabel}" Style="{StaticResource PlayButton}" Click="Play_Click" Focusable="False"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Khi chưa có game -->
            <Border x:Name="EmptyPanel" Background="{StaticResource Panel}" CornerRadius="12" Padding="36" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel MaxWidth="760">
                    <TextBlock x:Name="EmptyTitle" Text="Chưa có game nào" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="EmptyText" FontSize="22" TextWrapping="Wrap" LineHeight="32"/>
                    <WrapPanel Margin="0,20,0,0">
                        <Button Content="📂  Mở thư mục game" Style="{StaticResource BigButton}" Click="OpenGamesFolder_Click"/>
                        <Button Content="🔄  Quét game mới" Style="{StaticResource PlayButton}" Click="Scan_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Luôn hiển thị cách thoát game -->
        <Border Grid.Row="3" Background="{StaticResource Accent}" CornerRadius="8" Padding="16,8" Margin="0,10,0,4">
            <TextBlock Foreground="{StaticResource AccentFg}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap">
                <Run Text="Thoát game: giữ START + SELECT trên tay cầm, hoặc bấm Esc trên bàn phím."/>
            </TextBlock>
        </Border>

        <!-- Nút chính -->
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource FgDim}" FontSize="18" Margin="10,0"/>
            <WrapPanel>
                <Button Content="🔄  Quét game mới" Style="{StaticResource BigButton}" Click="Scan_Click"/>
                <Button Content="📂  Mở thư mục game" Style="{StaticResource BigButton}" Click="OpenGamesFolder_Click"/>
                <Button Content="⚙  Cài đặt" Style="{StaticResource BigButton}" Click="Settings_Click"/>
                <Button Content="❓  Trợ giúp" Style="{StaticResource BigButton}" Click="Help_Click"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
