<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <!-- Chuỗi giao diện từng ngôn ngữ (vi, en...), nhúng trong dll để luôn có sẵn -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Lang\*.json" LogicalName="GameCenter.Core.Localization.Lang.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
