<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameCenter.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- Hi-tech: nền xanh đen, viền neon cyan; chữ lớn, tương phản cao -->
        <Color x:Key="CyanColor">#00E5FF</Color>
        <Color x:Key="MagentaColor">#FF3D9A</Color>
        <!-- Màu nhấn của theme Fluent (ô tích, thanh cuộn, ô chọn) theo tông cyan -->
        <Color x:Key="SystemAccentColor">#00B8D4</Color>
        <Color x:Key="SystemAccentColorDark1">#0097A7</Color>
        <Color x:Key="SystemAccentColorDark2">#00838F</Color>
        <Color x:Key="SystemAccentColorDark3">#006064</Color>
        <Color x:Key="SystemAccentColorLight1">#00E5FF</Color>
        <Color x:Key="SystemAccentColorLight2">#18FFFF</Color>
        <Color x:Key="SystemAccentColorLight3">#84FFFF</Color>

        <LinearGradientBrush x:Key="Bg" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#060A14" Offset="0"/>
            <GradientStop Color="#0B1328" Offset="0.55"/>
            <GradientStop Color="#120A26" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Sidebar" Color="#B3070C18"/>
        <SolidColorBrush x:Key="Panel" Color="#CC101A30"/>
        <SolidColorBrush x:Key="PanelHi" Color="#E6152541"/>
        <SolidColorBrush x:Key="Line" Color="#3300E5FF"/>
        <SolidColorBrush x:Key="LineStrong" Color="#8000E5FF"/>
        <SolidColorBrush x:Key="Fg" Color="#F2F7FF"/>
        <SolidColorBrush x:Key="FgDim" Color="#9FB3CC"/>
        <SolidColorBrush x:Key="Accent" Color="#00E5FF"/>
        <SolidColorBrush x:Key="Accent2" Color="#FF3D9A"/>
        <SolidColorBrush x:Key="AccentFg" Color="#03121A"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB74D"/>
        <LinearGradientBrush x:Key="Play" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#00E5FF" Offset="0"/>
            <GradientStop Color="#2979FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Brand" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#00E5FF" Offset="0"/>
            <GradientStop Color="#FF3D9A" Offset="1"/>
        </LinearGradientBrush>

        <FontFamily x:Key="TechFont">Bahnschrift, Segoe UI, SF Pro Display, Helvetica Neue, Ubuntu, DejaVu Sans, sans-serif</FontFamily>
        <FontFamily x:Key="UiFont">Segoe UI, SF Pro Text, Helvetica Neue, Ubuntu, Noto Sans, DejaVu Sans, sans-serif</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Nút chung: kính mờ, viền cyan -->
        <Style Selector="Button.big">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="#661A2A48"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.big:pointerover /template/ Border#b">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BoxShadow" Value="0 0 12 0 #7300E5FF"/>
        </Style>
        <Style Selector="Button.big:focus-visible /template/ Border#b">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BoxShadow" Value="0 0 22 0 #BF00E5FF"/>
        </Style>
        <Style Selector="Button.big:disabled /template/ Border#b">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Nút Chơi: gradient cyan → xanh, chữ tối -->
        <Style Selector="Button.play">
            <Setter Property="Background" Value="{StaticResource Play}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <!-- Mục điều hướng trong sidebar -->
        <Style Selector="RadioButton.nav">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="b" Background="Transparent" CornerRadius="12" BorderThickness="1.5" BorderBrush="Transparent"/>
                        <Border Name="bar" Width="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,10"
                                Background="{StaticResource Accent}" IsVisible="False" BoxShadow="0 0 12 0 #BF00E5FF"/>
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="18,0,14,0" VerticalAlignment="Center"
                                          HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.nav:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style Selector="RadioButton.nav:pointerover /template/ Border#b">
            <Setter Property="Background" Value="#3300E5FF"/>
        </Style>
        <Style Selector="RadioButton.nav:checked">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style Selector="RadioButton.nav:checked /template/ Border#b">
            <Setter Property="Background" Value="#2600E5FF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        </Style>
        <Style Selector="RadioButton.nav:checked /template/ Border#bar">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Nút chọn cách điều khiển (Tay cầm / Bàn phím) -->
        <Style Selector="RadioButton.segment">
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="b" CornerRadius="10" Margin="3" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ Border#b">
            <Setter Property="Background" Value="{StaticResource Play}"/>
            <Setter Property="BoxShadow" Value="0 0 12 0 #7300E5FF"/>
        </Style>

        <!-- Thẻ game trong danh sách -->
        <Style Selector="ListBox.games">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.games ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,5,8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.games ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.games ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.games ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.games ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.games ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.card">
            <Setter Property="Background" Value="{StaticResource PanelHi}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.card">
            <Setter Property="Background" Value="{StaticResource PanelHi}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="BoxShadow" Value="0 0 22 0 #BF00E5FF"/>
        </Style>

        <!-- Ô nhập -->
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#80101A30"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#80101A30"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            <Setter Property="Background" Value="#80101A30"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="MinHeight" Value="46"/>
        </Style>
    </Application.Styles>
</Application>
